# Application
APP_ENV=development
APP_DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL (used by docker-compose and SQLAlchemy)
POSTGRES_DB=searchiq
POSTGRES_USER=searchiq
POSTGRES_PASSWORD=searchiq
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# OpenRouter (LLM & VLM)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
